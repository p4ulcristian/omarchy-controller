#!/bin/sh
# Restart a wedged USB host controller: unbind it from xhci_hcd and bind it
# again. Everything on it drops out for a moment and comes back. Installed
# root-owned in /usr/local/bin; iris-controller runs it through sudo when the
# controller goes silent. Usage: iris-controller-usb-reset 0000:02:00.0
set -eu
addr=${1:-}
case "$addr" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f].[0-7]) ;;
  *) echo "usage: $0 <PCI address of a USB host controller>" >&2; exit 2 ;;
esac
drv=/sys/bus/pci/drivers/xhci_hcd
[ -e "$drv/$addr" ] || { echo "$addr is not bound to xhci_hcd" >&2; exit 1; }
printf %s "$addr" > "$drv/unbind"
sleep 1
printf %s "$addr" > "$drv/bind"
